<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(REPRO_TFM)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <NpgsqlVersion>$(REPRO_NPGSQL_VERSION)</NpgsqlVersion>
    <NpgsqlVersion Condition="'$(NpgsqlVersion)' == ''">10.0.3</NpgsqlVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The copy of the postprocessor derives from provider types marked as internal API. -->
    <NoWarn>$(NoWarn);EF1001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlVersion)" />
  </ItemGroup>

</Project>
