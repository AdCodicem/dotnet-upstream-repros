<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- repro.sh sets REPRO_TFM; the default is .NET 10. -->
    <TargetFramework>$(REPRO_TFM)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- repro.sh may set REPRO_JSONPATCH_VERSION; the default is the latest 10.0 or 11.0 release of the package. -->
    <JsonPatchVersion>$(REPRO_JSONPATCH_VERSION)</JsonPatchVersion>
    <JsonPatchVersion Condition="'$(JsonPatchVersion)' == '' and '$(TargetFramework)' == 'net10.0'">10.0.13</JsonPatchVersion>
    <JsonPatchVersion Condition="'$(JsonPatchVersion)' == '' and '$(TargetFramework)' == 'net11.0'">11.0.0-rc.1.26425.128</JsonPatchVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Newtonsoft.Json-based package, not Microsoft.AspNetCore.JsonPatch.SystemTextJson. -->
    <PackageReference Include="Microsoft.AspNetCore.JsonPatch" Version="$(JsonPatchVersion)" />
  </ItemGroup>

</Project>
