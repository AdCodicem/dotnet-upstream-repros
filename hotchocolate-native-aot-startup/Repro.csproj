<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- repro.sh sets REPRO_HC_VERSION; the default is the latest 16.x release. -->
    <TargetFramework>net10.0</TargetFramework>
    <HotChocolateVersion>$(REPRO_HC_VERSION)</HotChocolateVersion>
    <HotChocolateVersion Condition="'$(HotChocolateVersion)' == ''">16.6.8</HotChocolateVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Every trimming and AOT warning of every assembly, not one per package. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate" Version="$(HotChocolateVersion)" />
    <!-- HotChocolate's source generator: [QueryType] and AddReproTypes(), the schema-building path meant for native AOT. -->
    <PackageReference Include="HotChocolate.Types.Analyzers" Version="$(HotChocolateVersion)" PrivateAssets="all" />
  </ItemGroup>

  <!-- dotnet publish -p:ReproRoot=true: the workaround, HotChocolate.Types kept whole. -->
  <ItemGroup Condition="'$(ReproRoot)' == 'true'">
    <TrimmerRootAssembly Include="HotChocolate.Types" />
  </ItemGroup>

</Project>
