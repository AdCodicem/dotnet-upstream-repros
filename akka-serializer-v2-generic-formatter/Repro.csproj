<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- repro.sh sets REPRO_AKKA_VERSION; the default is the latest prerelease. -->
    <AkkaVersion>$(REPRO_AKKA_VERSION)</AkkaVersion>
    <AkkaVersion Condition="'$(AkkaVersion)' == ''">1.6.0-beta3</AkkaVersion>
    <!-- -p:Workaround=true registers a closed subclass of the generic formatter instead. -->
    <DefineConstants Condition="'$(Workaround)' == 'true'">$(DefineConstants);WORKAROUND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Akka.Serialization.V2" Version="$(AkkaVersion)" />
  </ItemGroup>

</Project>
