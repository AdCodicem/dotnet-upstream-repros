<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NSwag.AspNetCore" Version="14.7.1" />
  </ItemGroup>

  <!-- repro.sh builds once with this reference and once without. Nothing in Program.cs uses the package: it stands for
       a library the application references that depends on it. -->
  <ItemGroup Condition="'$(ReferenceMvcNewtonsoftJson)' == 'true'">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.13" />
  </ItemGroup>

</Project>
