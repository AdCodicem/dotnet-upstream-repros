<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- repro.sh sets REPRO_TFM and REPRO_EF_VERSION; the defaults are the latest .NET 10 servicing release. -->
    <TargetFramework>$(REPRO_TFM)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <EfCoreVersion>$(REPRO_EF_VERSION)</EfCoreVersion>
    <EfCoreVersion Condition="'$(EfCoreVersion)' == ''">10.0.13</EfCoreVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- dotnet run -p:Workaround=true registers a comparer of its own for Qty?. -->
    <DefineConstants Condition="'$(Workaround)' == 'true'">$(DefineConstants);WORKAROUND</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" PrivateAssets="all" />
  </ItemGroup>

</Project>
