<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- repro.sh sets REPRO_TFM and REPRO_OPTIONS_VERSION; the defaults are .NET 10 and the latest 10.0 packages. -->
    <TargetFramework>$(REPRO_TFM)</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <OptionsVersion>$(REPRO_OPTIONS_VERSION)</OptionsVersion>
    <OptionsVersion Condition="'$(OptionsVersion)' == ''">10.0.13</OptionsVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Options carries the [OptionsValidator] source generator. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="$(OptionsVersion)" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="$(OptionsVersion)" />
  </ItemGroup>

</Project>
