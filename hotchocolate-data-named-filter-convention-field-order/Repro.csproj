<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- repro.sh sets REPRO_HC_VERSION; the default is the latest 16.x release. -->
    <TargetFramework>net10.0</TargetFramework>
    <HotChocolateVersion>$(REPRO_HC_VERSION)</HotChocolateVersion>
    <HotChocolateVersion Condition="'$(HotChocolateVersion)' == ''">16.6.8</HotChocolateVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <HotChocolateImplicitUsings>disable</HotChocolateImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HotChocolate" Version="$(HotChocolateVersion)" />
    <PackageReference Include="HotChocolate.Data" Version="$(HotChocolateVersion)" />
  </ItemGroup>

</Project>
