<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keeps the generated logging code under obj/, so repro.sh can print which tag array each value goes to -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <!-- LogPropertiesAttribute.Transitive is [Experimental("EXTEXP0003")] -->
    <NoWarn>$(NoWarn);EXTEXP0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Telemetry" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Compliance.Redaction" Version="10.11.0" />
  </ItemGroup>

</Project>
