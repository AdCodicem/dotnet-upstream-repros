<Project Sdk="Microsoft.NET.Sdk">

  <!-- Compiles the code Repro.csproj generates into this folder. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- The generated code's own warnings are not the point. -->
    <NoWarn>$(NoWarn);CS8981;CS0108;CS0114;CS0472;CS0612;CS1573;CS1591;CS8073;CS3016;CS8600;CS8602;CS8603;CS8604;CS8625;CS8765</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
